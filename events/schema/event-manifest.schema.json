{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aehrc/sparked-fhir-server-configuration/events/schema/event-manifest.schema.json",
  "title": "Sparked event manifest",
  "description": "One file per event under events/. scripts/render_event.py validates it against this schema and renders the participant guide and the operator checklist from it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "short_name",
    "timezone",
    "venue",
    "event_page",
    "dates",
    "freeze",
    "servers",
    "version_policy",
    "terminology",
    "inferno",
    "data",
    "sandbox",
    "status_page",
    "help",
    "known_issues",
    "loader_banner",
    "outputs"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "description": "yyyy-mm-place; must equal the file name without .yaml.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[a-z0-9-]+$"
    },
    "name": { "type": "string", "minLength": 1 },
    "short_name": { "type": "string", "minLength": 1 },
    "timezone": {
      "description": "IANA zone used to render every date and time, and checked against the offsets in this file.",
      "type": "string",
      "minLength": 1
    },
    "venue": { "type": "string", "minLength": 1 },
    "event_page": { "$ref": "#/$defs/url" },
    "dates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "programme"],
      "properties": {
        "start": { "$ref": "#/$defs/date" },
        "end": { "$ref": "#/$defs/date" },
        "programme": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "what"],
            "properties": {
              "date": { "$ref": "#/$defs/date" },
              "what": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "covers"],
      "properties": {
        "start": { "$ref": "#/$defs/datetime" },
        "end": { "$ref": "#/$defs/datetime" },
        "covers": {
          "description": "What does not change inside the window, in participant terms.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "servers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/server" }
    },
    "version_policy": {
      "description": "One or two sentences on why each server serves the versions it does.",
      "type": "string",
      "minLength": 1
    },
    "terminology": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "note"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url": { "$ref": "#/$defs/url" },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "inferno": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "release", "kits"],
      "properties": {
        "url": { "$ref": "#/$defs/url" },
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "status", "live_today", "tracking"],
          "properties": {
            "version": { "type": "string", "minLength": 1 },
            "status": {
              "description": "planned until the promotion merges and the site serves this release; then live.",
              "enum": ["planned", "live"]
            },
            "live_today": { "type": "string", "minLength": 1 },
            "tracking": { "$ref": "#/$defs/url" }
          }
        },
        "kits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "live_today", "suites"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "live_today": { "type": "string", "minLength": 1 },
              "page": { "$ref": "#/$defs/url" },
              "suites": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "title"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                    "title": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loaded_on", "sets", "note"],
      "properties": {
        "loaded_on": { "$ref": "#/$defs/date" },
        "sets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "repo", "ref", "commit", "path"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "repo": { "$ref": "#/$defs/url" },
              "ref": {
                "description": "The branch or tag the data was taken from.",
                "type": "string",
                "minLength": 1
              },
              "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "path": { "type": "string", "minLength": 1 },
              "note": { "type": "string" }
            }
          }
        },
        "note": { "type": "string" }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "decision",
        "url",
        "mode",
        "access_code_distribution",
        "opens",
        "creation_closes",
        "expiry_days_after_event_end",
        "caps",
        "fallback"
      ],
      "properties": {
        "status": {
          "description": "planned before the go/no-go; open once participants can create one; cancelled on a no-go (the guide then describes the fallback).",
          "enum": ["planned", "open", "cancelled"]
        },
        "decision": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/url" },
        "mode": {
          "description": "event: an event access code, no account. standing: GitHub login, stricter limits.",
          "enum": ["event", "standing"]
        },
        "access_code_distribution": {
          "description": "Where participants find the access code. The code itself never goes in this public file.",
          "type": "string",
          "minLength": 1
        },
        "opens": { "$ref": "#/$defs/datetime" },
        "creation_closes": { "$ref": "#/$defs/datetime" },
        "expiry_days_after_event_end": { "type": "integer", "minimum": 0, "maximum": 90 },
        "caps": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_live_sandboxes", "max_creations_per_ip_per_hour", "max_resources_per_sandbox"],
          "properties": {
            "max_live_sandboxes": { "type": "integer", "minimum": 1 },
            "max_creations_per_ip_per_hour": { "type": "integer", "minimum": 1 },
            "max_resources_per_sandbox": { "type": "integer", "minimum": 1 }
          }
        },
        "fallback": { "type": "string", "minLength": 1 }
      }
    },
    "status_page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public", "url", "note"],
      "properties": {
        "public": { "type": "boolean" },
        "url": { "oneOf": [{ "$ref": "#/$defs/url" }, { "type": "null" }] },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "help": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "use_for"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url": { "$ref": "#/$defs/url" },
          "use_for": { "type": "string", "minLength": 1 }
        }
      }
    },
    "known_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "detail", "workaround", "last_checked"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "detail": { "type": "string", "minLength": 1 },
          "workaround": { "type": "string", "minLength": 1 },
          "last_checked": { "$ref": "#/$defs/date" }
        }
      }
    },
    "loader_banner": {
      "description": "The event block for loader.sparked-fhir.com (the loader repo's helm values: enabled, title, message, date). Kept here so one change can feed it to the loader.",
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "title", "message", "date"],
      "properties": {
        "enabled": { "type": "boolean" },
        "title": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "date": { "$ref": "#/$defs/date" }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guide", "checklist"],
      "properties": {
        "guide": { "type": "string", "pattern": "^docs/participants/[a-z0-9-]+\\.md$" },
        "checklist": { "type": "string", "pattern": "^docs/operators/events/[a-z0-9-]+-checklist\\.md$" }
      }
    }
  },
  "$defs": {
    "url": { "type": "string", "pattern": "^https://[^\\s]+$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "datetime": {
      "description": "ISO 8601 with an explicit UTC offset, which must match the event timezone on that date.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?[+-][0-9]{2}:[0-9]{2}$"
    },
    "ig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "package", "version", "status", "profile_example"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "package": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
        "version": { "type": "string", "minLength": 1 },
        "status": {
          "description": "Publication status of this IG version.",
          "enum": ["trial-use", "normative", "ballot", "draft", "release"]
        },
        "profile_example": {
          "description": "One profile canonical (without |version) from this IG, used to show the $validate parameter.",
          "type": "string",
          "pattern": "^http://[^\\s|]+$"
        },
        "unversioned_default": {
          "description": "true when an unversioned profile canonical resolves to this version on the server.",
          "type": "boolean"
        },
        "note": { "type": "string" }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "run_by", "fhir_base", "access", "igs", "last_checked"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "run_by": { "type": "string", "minLength": 1 },
        "fhir_base": { "$ref": "#/$defs/url" },
        "access": { "type": "string", "minLength": 1 },
        "software": { "type": "string" },
        "smart": {
          "type": "object",
          "additionalProperties": false,
          "required": ["configuration", "issuer", "authorize", "token", "jwks"],
          "properties": {
            "configuration": { "$ref": "#/$defs/url" },
            "openid_configuration": { "$ref": "#/$defs/url" },
            "issuer": { "$ref": "#/$defs/url" },
            "authorize": { "$ref": "#/$defs/url" },
            "token": { "$ref": "#/$defs/url" },
            "jwks": {
              "description": "A JWKS URL that answers with the signing keys (use this one to check id_token signatures).",
              "$ref": "#/$defs/url"
            }
          }
        },
        "igs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ig" } },
        "not_served": {
          "description": "Versions participants may expect here that this server does not hold.",
          "type": "array",
          "items": { "type": "string" }
        },
        "last_checked": { "$ref": "#/$defs/date" }
      }
    }
  }
}
