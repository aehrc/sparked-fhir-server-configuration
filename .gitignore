builds/
terraform/.terraform
.DS_Store
.terraform/
.agent/
.claude/

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform variable files that might contain secrets
*.tfvars
*.auto.tfvars

# Crash log files
crash.log

# Exclude all .tfvars files, which are likely to contain sensitive data
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# IDE
.idea/
.vscode/
*.swp
*.swo

__pycache__/

# Binary files
terminology-servers/atomio-ig-feeder

# Terraform backend config. One per deployment; the key lives in these files
# (not provider.tf) so an init cannot silently attach to the wrong state.
terraform/backend.hcl
terraform/backend-*.hcl

# Saved plan files. These embed resolved variable values and data-source reads,
# including secret ARNs and generated database credentials, so they must never
# be committed.
*.plan
*.tfplan

# Python virtual environment
.venv/